{
  "name": "@velessoft/ui",
  "version": "0.1.0",
  "description": "Compact, punk-inspired React components by villetacore.",
  "type": "module",
  "author": "villetacore <villetacore@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/villetacore/velessoft-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/villetacore/velessoft-ui#readme",
  "bugs": {
    "url": "https://github.com/villetacore/velessoft-ui/issues"
  },
  "keywords": [
    "velessoft",
    "design-system",
    "ui",
    "react",
    "typescript"
  ]
}
