{
  "name": "@villetacore/velessoft-ui",
  "version": "0.4.0",
  "description": "Compact, punk-inspired React components by villetacore: 35+ accessible, typed components.",
  "type": "module",
  "author": "villetacore <villetacore@proton.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/villetacore/velessoft-ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./full.css": "./dist/full.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node ../../scripts/build-css.mjs && cp ../css/dist/velessoft.css dist/styles.css && cp ../css/dist/velessoft.full.css dist/full.css",
    "prepack": "node ../../scripts/build-tokens.mjs && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/villetacore/velessoft-ui#readme",
  "bugs": {
    "url": "https://github.com/villetacore/velessoft-ui/issues"
  },
  "keywords": [
    "velessoft",
    "design-system",
    "ui",
    "react",
    "react-components",
    "typescript",
    "accessible",
    "component-library"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
